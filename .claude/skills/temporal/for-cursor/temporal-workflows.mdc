```python
# Python Example
from temporalio import workflow

@workflow.defn
class ApprovalWorkflow:
    def __init__(self):
        self.approved = False
        self.rejected = False
        self.approver = ""
        self.status = "pending"
    
    @workflow.run
    async def run(self, request_id: str) -> str:
        # Wait for approval or rejection (with timeout)
        await workflow.wait_condition(
            lambda: self.approved or self.rejected,
            timeout=timedelta(days=7)
        )
        
        if self.approved:
            await workflow.execute_activity(
                process_approval,
                request_id,
                self.approver,
                start_to_close_timeout=timedelta(minutes=1)
            )
            return "Approved"
        elif self.rejected:
            await workflow.execute_activity(
                process_rejection,
                request_id,
                start_to_close_timeout=timedelta(minutes=1)
            )
            return "Rejected"
        else:
            self.status = "timeout"
            return "Request timeout"
    
    @workflow.signal
    async def approve(self, approver_name: str):
        self.approved = True
        self.approver = approver_name
        self.status = "approved"
    
    @workflow.signal
    async def reject(self):
        self.rejected = True
        self.status = "rejected"
    
    @workflow.query
    def status_query(self) -> str:
        return self.status
```

### Pattern 7: Child Workflows

**Use Case**: Compose workflows hierarchically

```typescript
// TypeScript Example

// Parent workflow
export async function orderFulfillmentWorkflow(orderId: string): Promise<string> {
  const { validateOrder } = proxyActivities<typeof activities>({
    startToCloseTimeout: '1 minute',
  });
  
  // Validate order first
  const isValid = await validateOrder(orderId);
  if (!isValid) {
    throw new Error('Invalid order');
  }
  
  // Start child workflows in parallel
  const [paymentResult, inventoryResult] = await Promise.all([
    startChild(paymentProcessingWorkflow, {
      args: [orderId],
      workflowId: `payment-${orderId}`,
    }),
    startChild(inventoryManagementWorkflow, {
      args: [orderId],
      workflowId: `inventory-${orderId}`,
    }),
  ]);
  
  // Start shipping workflow after payment and inventory are confirmed
  const shippingResult = await startChild(shippingWorkflow, {
    args: [orderId, paymentResult.transactionId],
    workflowId: `shipping-${orderId}`,
  });
  
  return `Order fulfilled: ${shippingResult.trackingNumber}`;
}

// Child workflow example
export async function paymentProcessingWorkflow(orderId: string): Promise<PaymentResult> {
  const { chargeCard, updatePaymentStatus } = proxyActivities<typeof activities>({
    startToCloseTimeout: '2 minutes',
  });
  
  const result = await chargeCard(orderId);
  await updatePaymentStatus(orderId, 'completed');
  
  return result;
}
```

