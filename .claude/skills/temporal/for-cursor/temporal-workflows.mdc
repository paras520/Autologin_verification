### Pattern 2: Parallel Execution (Fan-Out/Fan-In)

**Use Case**: Execute multiple activities in parallel, wait for all

```typescript
// TypeScript Example
export async function dataProcessingWorkflow(fileIds: string[]): Promise<string[]> {
  const { processFile } = proxyActivities<typeof activities>({
    startToCloseTimeout: '5 minutes',
  });
  
  // Execute all file processing in parallel
  const results = await Promise.all(
    fileIds.map(fileId => processFile(fileId))
  );
  
  return results;
}
```

```python
# Python Example
import asyncio

@workflow.defn
class DataProcessingWorkflow:
    @workflow.run
    async def run(self, file_ids: list[str]) -> list[str]:
        # Execute all file processing in parallel
        results = await asyncio.gather(*[
            workflow.execute_activity(
                process_file,
                file_id,
                start_to_close_timeout=timedelta(minutes=5)
            )
            for file_id in file_ids
        ])
        
        return results
```

```go
// Go Example
func DataProcessingWorkflow(ctx workflow.Context, fileIDs []string) ([]string, error) {
    ao := workflow.ActivityOptions{
        StartToCloseTimeout: 5 * time.Minute,
    }
    ctx = workflow.WithActivityOptions(ctx, ao)
    
    // Create futures for parallel execution
    var futures []workflow.Future
    for _, fileID := range fileIDs {
        future := workflow.ExecuteActivity(ctx, ProcessFile, fileID)
        futures = append(futures, future)
    }
    
    // Wait for all to complete
    var results []string
    for _, future := range futures {
        var result string
        if err := future.Get(ctx, &result); err != nil {
            return nil, err
        }
        results = append(results, result)
    }
    
    return results, nil
}
```

### Pattern 3: Conditional Logic

**Use Case**: Different paths based on activity results

```typescript
// TypeScript Example
export async function userOnboardingWorkflow(userId: string): Promise<string> {
  const { validateUser, sendWelcomeEmail, scheduleCall, sendRejectionEmail } = 
    proxyActivities<typeof activities>({
      startToCloseTimeout: '2 minutes',
    });
  
  // Validate user
  const isValid = await validateUser(userId);
  
  if (isValid) {
    // Success path
    await sendWelcomeEmail(userId);
    await scheduleCall(userId);
    return 'User onboarded';
  } else {
    // Rejection path
    await sendRejectionEmail(userId);
    return 'User rejected';
  }
}
```

### Pattern 4: Retry with Different Strategies

**Use Case**: Custom retry logic for different failure types

```typescript
// TypeScript Example
export async function resilientApiCallWorkflow(endpoint: string): Promise<any> {
  const { callExternalApi } = proxyActivities<typeof activities>({
    startToCloseTimeout: '30 seconds',
    retry: {
      initialInterval: '1s',
      backoffCoefficient: 2,
      maximumAttempts: 5,
      maximumInterval: '1m',
      nonRetryableErrorTypes: ['InvalidInput', 'Unauthorized'],
    },
  });
  
  try {
    return await callExternalApi(endpoint);
  } catch (error) {
    // Workflow-level error handling
    console.log('API call failed after retries:', error);
    throw error;
  }
}
```

### Pattern 5: Saga Pattern (Compensation)

**Use Case**: Distributed transaction with rollback capability

```typescript
// TypeScript Example
export async function bookingWorkflow(bookingData: BookingData): Promise<string> {
  const activities = proxyActivities<typeof bookingActivities>({
    startToCloseTimeout: '2 minutes',
  });
  
  let flightBooked = false;
  let hotelBooked = false;
  let carBooked = false;
  
  try {
    // Step 1: Book flight
    await activities.bookFlight(bookingData.flightId);
    flightBooked = true;
    
    // Step 2: Book hotel
    await activities.bookHotel(bookingData.hotelId);
    hotelBooked = true;
    
    // Step 3: Book rental car
    await activities.bookCar(bookingData.carId);
    carBooked = true;
    
    // Success - confirm all
    await activities.confirmBooking(bookingData.bookingId);
    return 'Booking successful';
    
  } catch (error) {
    // Compensation logic
    if (carBooked) {
      await activities.cancelCar(bookingData.carId);
    }
    if (hotelBooked) {
      await activities.cancelHotel(bookingData.hotelId);
    }
    if (flightBooked) {
      await activities.cancelFlight(bookingData.flightId);
    }
    
    throw error; // Re-throw after cleanup
  }
}
```

### Pattern 6: Long-Running Workflow with Updates (2026)

**Use Case**: Workflow that responds to external events with synchronous responses

**Note**: As of 2026, Updates API is preferred over Signals when you need synchronous acknowledgment.

```typescript
// TypeScript Example - Using Updates API
import { defineUpdate, defineQuery, setHandler, condition } from '@temporalio/workflow';

const approveUpdate = defineUpdate<string, [string, string]>('approve');
const rejectUpdate = defineUpdate<string, [string, string]>('reject');
const statusQuery = defineQuery<string>('status');

export async function approvalWorkflow(requestId: string): Promise<string> {
  let approved = false;
  let rejected = false;
  let approver = '';
  let status = 'pending';
  
  // Set up update handlers (synchronous, validated)
  setHandler(approveUpdate, (approverName: string, comments: string): string => {
    if (approved || rejected) {
      throw new Error('Request already processed');
    }
    approved = true;
    approver = approverName;
    status = 'approved';
    return `Approved by ${approverName}`;
  });
  
  setHandler(rejectUpdate, (rejecterName: string, reason: string): string => {
    if (approved || rejected) {
      throw new Error('Request already processed');
    }
    rejected = true;
    status = 'rejected';
    return `Rejected by ${rejecterName}: ${reason}`;
  });
  
  setHandler(statusQuery, () => status);
  
  // Wait for approval or rejection (with timeout)
  const didComplete = await condition(() => approved || rejected, '7 days');
  
  if (!didComplete) {
    status = 'timeout';
    return 'Request timeout';
  }
  
  if (approved) {
    const { processApproval } = proxyActivities<typeof activities>({
      startToCloseTimeout: '1 minute',
    });
    await processApproval(requestId, approver);
    return 'Approved';
  } else {
    const { processRejection } = proxyActivities<typeof activities>({
      startToCloseTimeout: '1 minute',
    });
    await processRejection(requestId);
    return 'Rejected';
  }
}
```

