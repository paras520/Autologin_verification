// TypeScript Example - Service with Kill Switch
export class PaymentService {
  async processPayment(paymentId: string): Promise<PaymentResult> {
    // ✅ MANDATORY: Check kill switch FIRST
    const temporalState = (process.env.TEMPORAL_STATE || 'ON').toUpperCase();
    
    if (temporalState === 'OFF') {
      // Temporal DISABLED - bypass, execute directly
      console.warn('Temporal bypassed - TEMPORAL_STATE=OFF in .env');
      return this.processPaymentDirect(paymentId);
    } else {
      // Temporal ENABLED - execute via workflow
      return this.executePaymentWorkflow(paymentId);
    }
  }
  
  private async processPaymentDirect(paymentId: string): Promise<PaymentResult> {
    // Direct execution (original business logic)
    const payment = await this.paymentRepo.findById(paymentId);
    const result = await this.stripeClient.charge(payment);
    await this.notificationService.sendConfirmation(payment);
    return result;
  }
  
  private async executePaymentWorkflow(paymentId: string): Promise<PaymentResult> {
    // Temporal workflow execution
    const client = await getTemporalClient();
    const handle = await client.workflow.start(paymentWorkflow, {
      args: [paymentId],
      taskQueue: 'payments',
      workflowId: `payment-${paymentId}`,
    });
    return await handle.result();
  }
}
