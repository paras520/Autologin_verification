### Pattern 9: Infinite Workflow (Continue-As-New)

**Use Case**: Workflows that run indefinitely

```typescript
// TypeScript Example
import { continueAsNew, sleep } from '@temporalio/workflow';

export async function subscriptionMonitoringWorkflow(
  subscriptionId: string,
  iteration: number = 0
): Promise<void> {
  const { checkSubscriptionStatus, notifyExpiry } = proxyActivities<typeof activities>({
    startToCloseTimeout: '1 minute',
  });
  
  // Check subscription status
  const status = await checkSubscriptionStatus(subscriptionId);
  
  if (status === 'expired') {
    await notifyExpiry(subscriptionId);
    return; // End workflow
  }
  
  // Sleep for 1 day
  await sleep('1 day');
  
  // Continue as new to avoid history growth
  if (iteration >= 30) { // Every 30 days, continue as new
    await continueAsNew<typeof subscriptionMonitoringWorkflow>(subscriptionId, 0);
  } else {
    await continueAsNew<typeof subscriptionMonitoringWorkflow>(subscriptionId, iteration + 1);
  }
}
```

### Pattern 10: Rate Limiting

**Use Case**: Control execution rate of activities

```typescript
// TypeScript Example
export async function bulkEmailWorkflow(emailAddresses: string[]): Promise<void> {
  const { sendEmail } = proxyActivities<typeof activities>({
    startToCloseTimeout: '30 seconds',
  });
  
  // Send emails with rate limiting (max 10 per second)
  const batchSize = 10;
  for (let i = 0; i < emailAddresses.length; i += batchSize) {
    const batch = emailAddresses.slice(i, i + batchSize);
    
    // Process batch in parallel
    await Promise.all(batch.map(email => sendEmail(email)));
    
    // Wait 1 second before next batch (rate limiting)
    if (i + batchSize < emailAddresses.length) {
      await sleep('1 second');
    }
  }
}
```

