```go
package main

import (
    "context"
    "fmt"
    "log"
    "myapp/app"
    "myapp/config"
    "strings"
    
    "go.temporal.io/sdk/client"
)

func main() {
    // Load configuration
    cfg, err := config.Load()
    if err != nil {
        log.Fatalf("Failed to load configuration: %v", err)
    }

    // Create Temporal client
    clientOptions := client.Options{
        HostPort:  cfg.URI,
        Namespace: cfg.Namespace,
    }
    
    if cfg.TLS != nil {
        clientOptions.ConnectionOptions = client.ConnectionOptions{
            TLS: cfg.TLS,
        }
    }
    
    c, err := client.Dial(clientOptions)
    if err != nil {
        log.Fatalln("Unable to create client", err)
    }
    defer c.Close()

    // Prepare order data
    orderData := app.OrderData{
        OrderID:    "ORD-123",
        CustomerID: "CUST-456",
        Items: []app.OrderItem{
            {ProductID: "PROD-1", Quantity: 2, Price: 29.99},
            {ProductID: "PROD-2", Quantity: 1, Price: 49.99},
        },
        Total: 109.97,
    }

    // Start workflow
    workflowID := "order-" + orderData.OrderID
    workflowOptions := client.StartWorkflowOptions{
        ID:        workflowID,
        TaskQueue: cfg.TaskQueue,
    }

    log.Printf(`
╔════════════════════════════════════════════════════════════╗
║           STARTING TEMPORAL WORKFLOW                       ║
╚════════════════════════════════════════════════════════════╝

  Environment: %s
  Workflow ID: %s
  Task Queue: %s
`, cfg.Namespace, workflowID, cfg.TaskQueue)

    we, err := c.ExecuteWorkflow(context.Background(), workflowOptions, app.OrderWorkflow, orderData)
    if err != nil {
        log.Fatalln("Unable to execute workflow", err)
    }

    log.Printf("✓ Workflow started: %s", we.GetID())
    
    // Generate UI URL
    uiURL := strings.Replace(cfg.URI, ":7233", ":8080", 1)
    log.Printf("  View in Temporal UI: http://%s/namespaces/%s/workflows/%s\n", 
        uiURL, cfg.Namespace, we.GetID())

    log.Println("Waiting for workflow to complete...")
    
    // Wait for result
    var result string
    err = we.Get(context.Background(), &result)
    if err != nil {
        log.Fatalln("Unable to get workflow result", err)
    }

    fmt.Printf("\n✓ Workflow completed: %s\n", result)
}
