### Complete Example: Order Processing

**activities.go**:
```go
package app

import (
    "context"
    "fmt"
    "time"
    "go.temporal.io/sdk/activity"
)

type OrderData struct {
    OrderID    string
    CustomerID string
    Items      []OrderItem
    Total      float64
}

type OrderItem struct {
    ProductID string
    Quantity  int
    Price     float64
}

type PaymentResult struct {
    TransactionID string
    Status        string
    Amount        float64
}

// ProcessPayment activity
func ProcessPayment(ctx context.Context, customerID string, amount float64) (PaymentResult, error) {
    logger := activity.GetLogger(ctx)
    logger.Info("Processing payment", "customerId", customerID, "amount", amount)
    
    // Simulate payment processing
    time.Sleep(1 * time.Second)
    
    return PaymentResult{
        TransactionID: fmt.Sprintf("txn_%d", time.Now().Unix()),
        
        Amount:        amount,
    }, nil
}

// ReserveInventory activity
func ReserveInventory(ctx context.Context, items []OrderItem) error {
    logger := activity.GetLogger(ctx)
    logger.Info("Reserving inventory", "items", items)
    
    for _, item := range items {
        // Check cancellation
        if ctx.Err() != nil {
            return ctx.Err()
        }
        
        // Simulate inventory check
        time.Sleep(500 * time.Millisecond)
        
        // Heartbeat for progress
        activity.RecordHeartbeat(ctx, map[string]interface{}{
            "processedItem": item.ProductID,
        })
    }
    
    return nil
}

// SendNotification activity
func SendNotification(ctx context.Context, customerID, notificationType string, data map[string]interface{}) error {
    logger := activity.GetLogger(ctx)
    logger.Info("Sending notification", 
        "customerId", customerID, 
        "type", notificationType, 
        "data", data,
    )
    
    // Simulate email sending
    time.Sleep(500 * time.Millisecond)
    
    return nil
}

// ShipOrder activity
func ShipOrder(ctx context.Context, orderID, address string) (map[string]string, error) {
    logger := activity.GetLogger(ctx)
    logger.Info("Shipping order", "orderId", orderID, "address", address)
    
    time.Sleep(1 * time.Second)
    
    return map[string]string{
        "trackingNumber": fmt.Sprintf("TRK%d", time.Now().Unix()),
    }, nil
}
