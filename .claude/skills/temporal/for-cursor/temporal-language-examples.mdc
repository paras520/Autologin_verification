### Complete Example: Order Processing

**activities.py**:
```python
import asyncio
from dataclasses import dataclass
from temporalio import activity

@dataclass
class OrderData:
    order_id: str
    customer_id: str
    items: list[dict]
    total: float

@dataclass
class PaymentResult:
    transaction_id: str
    
    amount: float

@activity.defn
async def process_payment(customer_id: str, amount: float) -> PaymentResult:
    activity.logger.info(f"Processing payment for customer {customer_id}: ${amount}")
    
    # Simulate payment processing
    await asyncio.sleep(1)
    
    return PaymentResult(
        transaction_id=f"txn_{int(asyncio.get_event_loop().time())}",
        status="completed",
        amount=amount
    )

@activity.defn
async def reserve_inventory(items: list[dict]) -> None:
    activity.logger.info("Reserving inventory", extra={"items": items})
    
    for item in items:
        # Simulate inventory check
        await asyncio.sleep(0.5)
        
        # Heartbeat for progress
        activity.heartbeat({"processed_item": item["product_id"]})

@activity.defn
async def send_notification(customer_id: str, notification_type: str, data: dict) -> None:
    activity.logger.info(
        f"Sending {notification_type} notification to {customer_id}",
        extra={"data": data}
    )
    
    # Simulate email sending
    await asyncio.sleep(0.5)

@activity.defn
async def ship_order(order_id: str, address: str) -> dict:
    activity.logger.info(f"Shipping order {order_id} to {address}")
    
    await asyncio.sleep(1)
    
    return {
        "tracking_number": f"TRK{int(asyncio.get_event_loop().time())}"
    }
```

**workflows.py**:
```python
from datetime import timedelta
from temporalio import workflow
from temporalio.common import RetryPolicy

# Import activity types
with workflow.unsafe.imports_passed_through():
    from activities import (
        process_payment,
        reserve_inventory,
        send_notification,
        ship_order,
        OrderData,
    )

@workflow.defn
class OrderWorkflow:
    @workflow.run
    async def run(self, order_data: OrderData) -> str:
        workflow.logger.info("Order workflow started", extra={"order_id": order_data.order_id})
        
        try:
            # Step 1: Reserve inventory
            await workflow.execute_activity(
                reserve_inventory,
                order_data.items,
                start_to_close_timeout=timedelta(minutes=5),
                heartbeat_timeout=timedelta(seconds=30),
                retry_policy=RetryPolicy(
                    initial_interval=timedelta(seconds=1),
                    backoff_coefficient=2.0,
                    maximum_attempts=3,
                ),
            )
            workflow.logger.info("Inventory reserved")
            
            # Step 2: Process payment
            payment_result = await workflow.execute_activity(
                process_payment,
                order_data.customer_id,
                order_data.total,
                start_to_close_timeout=timedelta(minutes=5),
            )
            workflow.logger.info(
                "Payment processed",
                extra={"transaction_id": payment_result.transaction_id}
            )
            
            # Step 3: Send confirmation
            await workflow.execute_activity(
                send_notification,
                order_data.customer_id,
                "order-confirmed",
                {
                    "order_id": order_data.order_id,
                    "transaction_id": payment_result.transaction_id,
                },
                start_to_close_timeout=timedelta(minutes=2),
            )
            
            # Step 4: Wait before shipping
            await workflow.sleep(timedelta(hours=1))
            
            # Step 5: Ship order
            shipment_result = await workflow.execute_activity(
                ship_order,
                order_data.order_id,
                "Customer Address",
                start_to_close_timeout=timedelta(minutes=5),
            )
            workflow.logger.info(
                "Order shipped",
                extra={"tracking_number": shipment_result["tracking_number"]}
            )
            
            # Step 6: Send shipping notification
            await workflow.execute_activity(
                send_notification,
                order_data.customer_id,
                "order-shipped",
                {
                    "order_id": order_data.order_id,
                    "tracking_number": shipment_result["tracking_number"],
                },
                start_to_close_timeout=timedelta(minutes=2),
            )
            
            return f"Order {order_data.order_id} completed successfully"
            
        except Exception as e:
            workflow.logger.error("Order workflow failed", extra={"error": str(e)})
            
            # Notify customer of failure
            await workflow.execute_activity(
                send_notification,
                order_data.customer_id,
                "order-failed",
                {"order_id": order_data.order_id, "reason": str(e)},
                start_to_close_timeout=timedelta(minutes=2),
            )
            
            raise
