**src/config.ts**:
```typescript
import * as dotenv from 'dotenv';
import * as fs from 'fs';

// Load environment variables
dotenv.config();

interface TemporalConfig {
  uri: string;
  namespace: string;
  taskQueue: string;
  tls?: {
    clientCertPath: string;
    clientKeyPath: string;
    serverRootCACertPath?: string;
  };
  maxConcurrentActivities: number;
  maxConcurrentWorkflows: number;
}

function loadConfig(): TemporalConfig {
  const uri = process.env.TEMPORAL_URI;
  const namespace = process.env.TEMPORAL_NAMESPACE;

  if (!uri || !namespace) {
    throw new Error(
      'Missing required environment variables: TEMPORAL_URI and TEMPORAL_NAMESPACE must be set.\n' +
      'Please copy .env.example to .env and fill in your company\'s Temporal connection details.'
    );
  }

  // Validate namespace (must be one of the allowed phases)
  const allowedNamespaces = ['stage1', 'stage2', 'production'];
  if (!allowedNamespaces.includes(namespace)) {
    console.warn(
      `Warning: TEMPORAL_NAMESPACE="${namespace}" is not a standard phase.\n` +
      `Expected one of: ${allowedNamespaces.join(', ')}`
    );
  }

  const config: TemporalConfig = {
    uri,
    namespace,
    taskQueue: process.env.TASK_QUEUE || 'default',
    maxConcurrentActivities: parseInt(process.env.MAX_CONCURRENT_ACTIVITIES || '100'),
    maxConcurrentWorkflows: parseInt(process.env.MAX_CONCURRENT_WORKFLOWS || '50'),
  };

  // TLS configuration (optional)
  const certPath = process.env.TEMPORAL_TLS_CERT_PATH;
  const keyPath = process.env.TEMPORAL_TLS_KEY_PATH;
  const caPath = process.env.TEMPORAL_TLS_CA_PATH;

  if (certPath && keyPath) {
    // Validate that cert files exist
    if (!fs.existsSync(certPath)) {
      throw new Error(`TLS cert file not found: ${certPath}`);
    }
    if (!fs.existsSync(keyPath)) {
      throw new Error(`TLS key file not found: ${keyPath}`);
    }

    config.tls = {
      clientCertPath: certPath,
      clientKeyPath: keyPath,
      serverRootCACertPath: caPath,
    };

    console.log(`✓ TLS enabled for ${namespace} environment`);
  }

  console.log(`Temporal Configuration:
  Environment: ${namespace}
  URI: ${uri}
  Task Queue: ${config.taskQueue}
  TLS: ${config.tls ? 'Enabled' : 'Disabled'}
  `);

  return config;
}

export const config = loadConfig();
```

