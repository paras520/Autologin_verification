```typescript
import { Connection, WorkflowClient } from '@temporalio/client';
import * as fs from 'fs';
import { orderWorkflow } from './workflows';
import { OrderData } from './activities';
import { config } from './config';

async function startWorkflow() {
  // Create connection with TLS if configured
  const connectionOptions: any = {
    address: config.uri,
  };

  if (config.tls) {
    connectionOptions.tls = {
      clientCertPair: {
        crt: fs.readFileSync(config.tls.clientCertPath),
        key: fs.readFileSync(config.tls.clientKeyPath),
      },
    };

    if (config.tls.serverRootCACertPath) {
      connectionOptions.tls.serverRootCACertificate = fs.readFileSync(
        config.tls.serverRootCACertPath
      );
    }
  }

  const connection = await Connection.connect(connectionOptions);
  const client = new WorkflowClient({ 
    connection, 
    namespace: config.namespace 
  });

  const orderData: OrderData = {
    orderId: 'ORD-123',
    customerId: 'CUST-456',
    items: [
      { productId: 'PROD-1', quantity: 2, price: 29.99 },
      { productId: 'PROD-2', quantity: 1, price: 49.99 },
    ],
    total: 109.97,
  };

  console.log(`
╔════════════════════════════════════════════════════════════╗
║           STARTING TEMPORAL WORKFLOW                       ║
╚════════════════════════════════════════════════════════════╝

  Environment: ${config.namespace}
  Workflow ID: order-${orderData.orderId}
  Task Queue: ${config.taskQueue}
  `);

  const handle = await client.start(orderWorkflow, {
    args: [orderData],
    taskQueue: config.taskQueue,
    workflowId: `order-${orderData.orderId}`,
  });

  console.log(`✓ Workflow started: ${handle.workflowId}`);
  console.log(`  View in Temporal UI: ${config.uri.replace(':7233', ':8080')}/namespaces/${config.namespace}/workflows/${handle.workflowId}\n`);
  
  console.log('Waiting for workflow to complete...');
  const result = await handle.result();
  console.log(`\n✓ Workflow completed: ${result}`);

  await connection.close();
}

startWorkflow().catch((err) => {
  console.error('Failed to start workflow:', err);
  process.exit(1);
});
