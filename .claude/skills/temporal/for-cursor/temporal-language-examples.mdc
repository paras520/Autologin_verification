        self.uri = os.getenv("TEMPORAL_URI")
        self.namespace = os.getenv("TEMPORAL_NAMESPACE")
        
        # Validate required environment variables
        if not self.uri or not self.namespace:
            raise ValueError(
                "Missing required environment variables: TEMPORAL_URI and TEMPORAL_NAMESPACE must be set.\n"
                "Please copy .env.example to .env and fill in your company's Temporal connection details."
            )
        
        # Validate namespace
        allowed_namespaces = ["stage1", "stage2", "production"]
        if self.namespace not in allowed_namespaces:
            print(f"Warning: TEMPORAL_NAMESPACE='{self.namespace}' is not a standard phase.")
            print(f"Expected one of: {', '.join(allowed_namespaces)}")
        
        self.task_queue = os.getenv("TASK_QUEUE", "default")
        
        # TLS configuration (optional)
        self.tls_cert_path = os.getenv("TEMPORAL_TLS_CERT_PATH")
        self.tls_key_path = os.getenv("TEMPORAL_TLS_KEY_PATH")
        self.tls_ca_path = os.getenv("TEMPORAL_TLS_CA_PATH")
        
        # Worker configuration
        self.max_concurrent_activities = int(os.getenv("MAX_CONCURRENT_ACTIVITIES", "100"))
        self.max_concurrent_workflows = int(os.getenv("MAX_CONCURRENT_WORKFLOWS", "50"))
        
        # Print configuration
        print(f"""
Temporal Configuration:
  Environment: {self.namespace}
  URI: {self.uri}
  Task Queue: {self.task_queue}
  TLS: {'Enabled' if self.tls_cert_path and self.tls_key_path else 'Disabled'}
        """)
    
    def has_tls(self) -> bool:
        return bool(self.tls_cert_path and self.tls_key_path)

config = TemporalConfig()
