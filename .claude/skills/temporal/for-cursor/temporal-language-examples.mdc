**config/config.go**:
```go
package config

import (
    "crypto/tls"
    "fmt"
    "os"
    "strconv"
    "github.com/joho/godotenv"
)

type Config struct {
    URI                     string
    Namespace               string
    TaskQueue               string
    TLS                     *tls.Config
    MaxConcurrentActivities int
    MaxConcurrentWorkflows  int
}

func Load() (*Config, error) {
    // Load .env file
    _ = godotenv.Load()
    
    uri := os.Getenv("TEMPORAL_URI")
    namespace := os.Getenv("TEMPORAL_NAMESPACE")
    
    // Validate required variables
    if uri == "" || namespace == "" {
        return nil, fmt.Errorf(
            "missing required environment variables: TEMPORAL_URI and TEMPORAL_NAMESPACE must be set.\n" +
            "Please copy .env.example to .env and fill in your company's Temporal connection details.",
        )
    }
    
    // Validate namespace
    allowedNamespaces := []string{"stage1", "stage2", "production"}
    validNamespace := false
    for _, ns := range allowedNamespaces {
        if namespace == ns {
            validNamespace = true
            break
        }
    }
    if !validNamespace {
        fmt.Printf("Warning: TEMPORAL_NAMESPACE='%s' is not a standard phase.\n", namespace)
        fmt.Printf("Expected one of: %v\n", allowedNamespaces)
    }
    
    cfg := &Config{
        URI:       uri,
        Namespace: namespace,
        TaskQueue: getEnvOrDefault("TASK_QUEUE", "default"),
        MaxConcurrentActivities: getEnvAsInt("MAX_CONCURRENT_ACTIVITIES", 100),
        MaxConcurrentWorkflows:  getEnvAsInt("MAX_CONCURRENT_WORKFLOWS", 50),
    }
    
    // TLS configuration
    certPath := os.Getenv("TEMPORAL_TLS_CERT_PATH")
    keyPath := os.Getenv("TEMPORAL_TLS_KEY_PATH")
    
    if certPath != "" && keyPath != "" {
        cert, err := tls.LoadX509KeyPair(certPath, keyPath)
        if err != nil {
            return nil, fmt.Errorf("failed to load TLS certificates: %w", err)
        }
        
        cfg.TLS = &tls.Config{
            Certificates: []tls.Certificate{cert},
        }
        
        fmt.Printf("✓ TLS enabled for %s environment\n", namespace)
    }
    
    fmt.Printf(`
Temporal Configuration:
  Environment: %s
  URI: %s
  Task Queue: %s
  TLS: %s

`, cfg.Namespace, cfg.URI, cfg.TaskQueue, 
        func() string { if cfg.TLS != nil { return "Enabled" } else { return "Disabled" } }())
    
    return cfg, nil
}

func getEnvOrDefault(key, defaultValue string) string {
    if value := os.Getenv(key); value != "" {
        return value
    }
    return defaultValue
}

func getEnvAsInt(key string, defaultValue int) int {
    if value := os.Getenv(key); value != "" {
        if intVal, err := strconv.Atoi(value); err == nil {
            return intVal
        }
    }
    return defaultValue
}
