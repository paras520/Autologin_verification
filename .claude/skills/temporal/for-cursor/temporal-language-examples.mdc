**worker.py**:
```python
import asyncio
import signal
from temporalio.client import Client, TLSConfig
from temporalio.worker import Worker

from workflows import OrderWorkflow
from activities import process_payment, reserve_inventory, send_notification, ship_order
from config import config

async def main():
    # Create TLS config if certificates are provided
    tls_config = None
    if config.has_tls():
        with open(config.tls_cert_path, "rb") as f:
            client_cert = f.read()
        with open(config.tls_key_path, "rb") as f:
            client_key = f.read()
        
        tls_config = TLSConfig(
            client_cert=client_cert,
            client_private_key=client_key,
        )
        
        if config.tls_ca_path:
            with open(config.tls_ca_path, "rb") as f:
                tls_config.server_root_ca_cert = f.read()
        
        print(f"✓ TLS enabled for {config.namespace} environment")
    
    # Connect to Temporal
    client = await Client.connect(
        config.uri,
        namespace=config.namespace,
        tls=tls_config,
    )
    
    # Create worker
    worker = Worker(
        client,
        task_queue=config.task_queue,
        workflows=[OrderWorkflow],
        activities=[
            process_payment,
            reserve_inventory,
            send_notification,
            ship_order,
        ],
        max_concurrent_activities=config.max_concurrent_activities,
        max_concurrent_workflow_tasks=config.max_concurrent_workflows,
    )
    
    print(f"""
╔════════════════════════════════════════════════════════════╗
║              TEMPORAL WORKER STARTED                       ║
╚════════════════════════════════════════════════════════════╝

  Environment: {config.namespace}
  URI: {config.uri}
  Task Queue: {config.task_queue}
  
  Polling for tasks...
    """)
    
    # Graceful shutdown
    shutdown_event = asyncio.Event()
    
    def signal_handler():
        print("\nReceived shutdown signal, shutting down gracefully...")
        shutdown_event.set()
    
    loop = asyncio.get_event_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, signal_handler)
    
    # Run worker
    try:
        await worker.run()
    except asyncio.CancelledError:
        pass

if __name__ == "__main__":
    asyncio.run(main())
```

