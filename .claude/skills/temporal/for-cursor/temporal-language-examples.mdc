**workflows.go**:
```go
package app

import (
    "fmt"
    "time"
    "go.temporal.io/sdk/workflow"
)

// OrderWorkflow definition
func OrderWorkflow(ctx workflow.Context, orderData OrderData) (string, error) {
    logger := workflow.GetLogger(ctx)
    logger.Info("Order workflow started", "orderId", orderData.OrderID)
    
    // Activity options
    ao := workflow.ActivityOptions{
        StartToCloseTimeout: 5 * time.Minute,
        HeartbeatTimeout:    30 * time.Second,
        RetryPolicy: &workflow.RetryPolicy{
            InitialInterval:    time.Second,
            BackoffCoefficient: 2.0,
            MaximumAttempts:    3,
        },
    }
    ctx = workflow.WithActivityOptions(ctx, ao)
    
    // Step 1: Reserve inventory
    err := workflow.ExecuteActivity(ctx, ReserveInventory, orderData.Items).Get(ctx, nil)
    if err != nil {
        logger.Error("Failed to reserve inventory", "error", err)
        return "", err
    }
    logger.Info("Inventory reserved")
    
    // Step 2: Process payment
    var paymentResult PaymentResult
    err = workflow.ExecuteActivity(ctx, ProcessPayment, orderData.CustomerID, orderData.Total).Get(ctx, &paymentResult)
    if err != nil {
        logger.Error("Failed to process payment", "error", err)
        return "", err
    }
    logger.Info("Payment processed", "transactionId", paymentResult.TransactionID)
    
    // Step 3: Send confirmation
    notificationData := map[string]interface{}{
        "orderId":       orderData.OrderID,
        "transactionId": paymentResult.TransactionID,
    }
    err = workflow.ExecuteActivity(ctx, SendNotification, orderData.CustomerID, "order-confirmed", notificationData).Get(ctx, nil)
    if err != nil {
        logger.Warn("Failed to send confirmation", "error", err)
    }
    
    // Step 4: Wait before shipping
    err = workflow.Sleep(ctx, 1*time.Hour)
    if err != nil {
        return "", err
    }
    
    // Step 5: Ship order
    var shipmentResult map[string]string
    err = workflow.ExecuteActivity(ctx, ShipOrder, orderData.OrderID, "Customer Address").Get(ctx, &shipmentResult)
    if err != nil {
        logger.Error("Failed to ship order", "error", err)
        return "", err
    }
    logger.Info("Order shipped", "trackingNumber", shipmentResult["trackingNumber"])
    
    // Step 6: Send shipping notification
    shippingData := map[string]interface{}{
        "orderId":        orderData.OrderID,
        "trackingNumber": shipmentResult["trackingNumber"],
    }
    err = workflow.ExecuteActivity(ctx, SendNotification, orderData.CustomerID, "order-shipped", shippingData).Get(ctx, nil)
    if err != nil {
        logger.Warn("Failed to send shipping notification", "error", err)
    }
    
    return fmt.Sprintf("Order %s completed successfully", orderData.OrderID), nil
}
