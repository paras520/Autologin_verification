### Pattern 4: Serverless Workers (AWS Lambda)

```typescript
// lambda-worker.ts
import { Worker } from '@temporalio/worker';

// Cold start optimization
let worker: Worker | null = null;

export const handler = async (event: any) => {
  if (!worker) {
    worker = await Worker.create({
      connection: await NativeConnection.connect({
        address: process.env.TEMPORAL_ADDRESS,
      }),
      taskQueue: process.env.TASK_QUEUE,
      workflowsPath: require.resolve('./workflows'),
      activities,
    });
  }

  // Process for duration of Lambda
  const timeout = setTimeout(() => {
    worker?.shutdown();
  }, 14 * 60 * 1000); // 14 minutes (Lambda max is 15)

  await worker.run();
  clearTimeout(timeout);

  return { statusCode: 200 };
};
```

## Worker Configuration Reference

### TypeScript Worker Options

```typescript
interface WorkerOptions {
  // Connection
  connection: NativeConnection;
  namespace?: string;
  taskQueue: string;

  // Workflows
  workflowsPath?: string;
  workflowBundle?: WorkflowBundle;

  // Activities
  activities?: ActivityInterface;

  // Concurrency
  maxConcurrentActivityTaskExecutions?: number;      // Default: 100
  maxConcurrentWorkflowTaskExecutions?: number;      // Default: 100
  maxConcurrentActivityTaskPolls?: number;           // Default: 5
  maxConcurrentWorkflowTaskPolls?: number;          // Default: 5

  // Polling
  maxTaskQueueActivitiesPerSecond?: number;          // Rate limiting
  maxWorkerActivitiesPerSecond?: number;             // Rate limiting

  // Shutdown
  shutdownGraceTime?: string;                        // Default: '30s'

  // Observability
  enableSDKTracing?: boolean;
  interceptors?: WorkerInterceptors;

  // Advanced
  debugMode?: boolean;
  reuseV8Context?: boolean;
  stickyQueueScheduleToStartTimeout?: string;
}
```

### Python Worker Options

```python
Worker(
    client: Client,
    task_queue: str,
    
