### Go Worker

```go
// worker.go
package main

import (
    "log"
    "go.temporal.io/sdk/client"
    "go.temporal.io/sdk/worker"
)

func main() {
    // Create Temporal client
    c, err := client.Dial(client.Options{
        HostPort: "localhost:7233",
    })
    if err != nil {
        log.Fatalln("Unable to create client", err)
    }
    defer c.Close()

    // Create worker
    w := worker.New(c, "my-task-queue", worker.Options{
        MaxConcurrentActivityExecutionSize:      100,
        MaxConcurrentWorkflowTaskExecutionSize:  50,
    })

    // Register workflows
    w.RegisterWorkflow(MyWorkflow)
    
    // Register activities
    w.RegisterActivity(MyActivity)

    // Start worker
    log.Println("Worker started successfully")
    err = w.Run(worker.InterruptCh())
    if err != nil {
        log.Fatalln("Unable to start worker", err)
    }
}
```

### Java Worker

```java
// Worker.java
import io.temporal.client.WorkflowClient;
import io.temporal.serviceclient.WorkflowServiceStubs;
import io.temporal.worker.Worker;
import io.temporal.worker.WorkerFactory;

public class MyWorker {
    public static void main(String[] args) {
        // Create service stubs
        WorkflowServiceStubs service = WorkflowServiceStubs.newLocalServiceStubs();
        
        // Create client
        WorkflowClient client = WorkflowClient.newInstance(service);
        
        // Create worker factory
        WorkerFactory factory = WorkerFactory.newInstance(client);
        
        // Create worker
        Worker worker = factory.newWorker("my-task-queue");
        
        // Register workflows
        worker.registerWorkflowImplementationTypes(MyWorkflowImpl.class);
        
        // Register activities
        worker.registerActivitiesImplementations(new MyActivitiesImpl());
        
        // Start worker
        factory.start();
        System.out.println("Worker started successfully");
    }
}
```

## Worker Configuration Patterns

### Pattern 1: Multiple Task Queues

**Use Case**: Different workers for different workloads

```typescript
// TypeScript Example
async function runWorkers() {
  const connection = await NativeConnection.connect({
    address: 'localhost:7233',
  });

  // Worker 1: API-related workflows
  const apiWorker = await Worker.create({
    connection,
    taskQueue: 'api-queue',
    workflowsPath: require.resolve('./workflows/api'),
    activities: apiActivities,
    maxConcurrentActivityTaskExecutions: 50,
  });

  // Worker 2: Background jobs
  const backgroundWorker = await Worker.create({
    connection,
    taskQueue: 'background-queue',
    workflowsPath: require.resolve('./workflows/background'),
    activities: backgroundActivities,
    maxConcurrentActivityTaskExecutions: 200,
  });

  // Worker 3: High-priority tasks
  const priorityWorker = await Worker.create({
    connection,
    taskQueue: 'priority-queue',
    workflowsPath: require.resolve('./workflows/priority'),
    activities: priorityActivities,
    maxConcurrentActivityTaskExecutions: 10,
  });

  // Run all workers concurrently
  await Promise.all([
    apiWorker.run(),
    backgroundWorker.run(),
    priorityWorker.run(),
  ]);
}
```

### Pattern 2: Graceful Shutdown

**Use Case**: Clean worker termination

```typescript
// TypeScript Example
import { Worker } from '@temporalio/worker';

async function run() {
  const worker = await Worker.create({
    // ... configuration
  });

  // Handle shutdown signals
  const shutdownSignals: NodeJS.Signals[] = ['SIGTERM', 'SIGINT', 'SIGUSR2'];
  
  shutdownSignals.forEach((signal) => {
    process.once(signal, async () => {
      console.log(`Received ${signal}, shutting down gracefully...`);
      
      // Stop accepting new tasks
      worker.shutdown();
      
      // Wait for ongoing tasks to complete (with timeout)
      const shutdownTimeout = setTimeout(() => {
        console.log('Shutdown timeout, forcing exit');
        process.exit(1);
      }, 30000); // 30 second timeout
      
      await worker.shutdown();
      clearTimeout(shutdownTimeout);
      
      console.log('Worker shut down gracefully');
      process.exit(0);
    });
  });

  await worker.run();
}
```

```go
// Go Example
import (
    "os"
    "os/signal"
    "syscall"
)

func main() {
    // Create worker
    w := worker.New(c, "my-task-queue", worker.Options{})
    
    // Register workflows and activities
    w.RegisterWorkflow(MyWorkflow)
    w.RegisterActivity(MyActivity)

    // Handle shutdown
    sigChan := make(chan os.Signal, 1)
    signal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)
    
    go func() {
        <-sigChan
        log.Println("Received shutdown signal, stopping worker...")
        w.Stop()
    }()

    // Start worker
    log.Println("Worker started")
    err := w.Run(worker.InterruptCh())
    if err != nil {
        log.Fatalln("Worker error:", err)
    }
    
    log.Println("Worker stopped gracefully")
}
```

### Pattern 3: Worker with Health Checks

**Use Case**: Kubernetes/Docker deployments

```typescript
// TypeScript Example
import express from 'express';
import { Worker } from '@temporalio/worker';

async function run() {
  const worker = await Worker.create({
    // ... configuration
  });

  // Create HTTP server for health checks
  const app = express();
  let isHealthy = false;

  app.get('/health', (req, res) => {
    if (isHealthy) {
      res.status(200).json({ 
    } else {
      res.status(503).json({ 
    }
  });

  app.get('/ready', (req, res) => {
    if (isHealthy && worker.getState() === 'RUNNING') {
      res.status(200).json({ 
    } else {
      res.status(503).json({ 
    }
  });

  const server = app.listen(8080, () => {
    console.log('Health check server listening on port 8080');
  });

  // Start worker
  worker.run().then(() => {
    isHealthy = true;
  }).catch((err) => {
    console.error('Worker failed:', err);
    isHealthy = false;
    server.close();
    process.exit(1);
  });
}
```

```python
# Python Example
from aiohttp import web
from temporalio.client import Client
from temporalio.worker import Worker

async def health_check(request):
    if worker_healthy:
        return web.json_response({"status": "healthy"}, status=200)
    return web.json_response({"status": "unhealthy"}, status=503)

async def readiness_check(request):
    if worker_healthy and worker_running:
        return web.json_response({"status": "ready"}, status=200)
    return web.json_response({"status": "not ready"}, status=503)

async def main():
    global worker_healthy, worker_running
    
    # Setup health check server
    app = web.Application()
    app.router.add_get('/health', health_check)
    app.router.add_get('/ready', readiness_check)
    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, 'localhost', 8080)
    await site.start()
    
    # Create and run worker
    client = await Client.connect("localhost:7233")
    worker = Worker(
        client,
        task_queue="my-task-queue",
        workflows=[MyWorkflow],
        activities=[my_activity],
    )
    
    worker_healthy = True
    worker_running = True
    
    try:
        await worker.run()
    except Exception as e:
        print(f"Worker failed: {e}")
        worker_healthy = False
        worker_running = False
```

### Pattern 4: Activity-Only Worker

**Use Case**: Separate activity execution from workflow execution

```typescript
// TypeScript Example
const activityOnlyWorker = await Worker.create({
  connection,
  taskQueue: 'activity-queue',
  
  // Only activities, no workflows
  activities: heavyActivities,
  
  // Higher concurrency for activities
  maxConcurrentActivityTaskExecutions: 500,
  
  // No workflow execution
  maxConcurrentWorkflowTaskExecutions: 0,
});
```

### Pattern 5: Workflow-Only Worker

**Use Case**: Dedicated workflow orchestration

```typescript
// TypeScript Example
const workflowOnlyWorker = await Worker.create({
  connection,
  taskQueue: 'workflow-queue',
  
  // Only workflows
  workflowsPath: require.resolve('./workflows'),
  
  // No activities
  activities: {},
  
  // Focus on workflow execution
  maxConcurrentWorkflowTaskExecutions: 100,
  maxConcurrentActivityTaskExecutions: 0,
});
```

### Pattern 6: Worker with Session

**Use Case**: File operations with resource affinity

```typescript
// TypeScript Example
const worker = await Worker.create({
  connection,
  taskQueue: 'file-processing',
  workflowsPath: require.resolve('./workflows'),
  activities,
  
  // Enable sessions for resource affinity
  enableNonLocalActivities: false,
  maxConcurrentActivityTaskExecutions: 10,
  maxConcurrentActivityTaskPollers: 5,
  
  // Session configuration
  maxConcurrentSessionExecutionSize: 1000,
});
```

### Pattern 7: Worker with Custom Metrics

**Use Case**: Monitoring and observability

```typescript
// TypeScript Example
import { Worker } from '@temporalio/worker';
import { PrometheusMetricsExporter } from '@opentelemetry/exporter-prometheus';
import { MeterProvider } from '@opentelemetry/sdk-metrics';

// Setup metrics
const exporter = new PrometheusMetricsExporter({ port: 9090 });
const meterProvider = new MeterProvider();
meterProvider.addMetricReader(exporter);

const worker = await Worker.create({
  connection,
  taskQueue: 'monitored-queue',
  workflowsPath: require.resolve('./workflows'),
  activities,
  
  // Enable telemetry
  enableSDKTracing: true,
  
  // Custom interceptors for metrics
  interceptors: {
    activityInbound: [(ctx, next) => {
      const startTime = Date.now();
      return next(ctx).finally(() => {
        const duration = Date.now() - startTime;
        // Record custom metric
        recordActivityDuration(ctx.activityType, duration);
      });
    }],
  },
});
```

## Worker Deployment Patterns

### Pattern 1: Docker Container

```dockerfile
# Dockerfile
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci --production

# Copy application code
COPY . .

# Build TypeScript
RUN npm run build

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/health', (res) => process.exit(res.statusCode === 200 ? 0 : 1))"

# Run worker
CMD ["node", "dist/worker.js"]
```

```yaml
# docker-compose.yml
version: '3.8'

services:
  temporal-worker:
    build: .
    environment:
      - TEMPORAL_ADDRESS=temporal:7233
      - TEMPORAL_NAMESPACE=default
      - TASK_QUEUE=my-queue
    restart: unless-stopped
    depends_on:
      - temporal
    deploy:
      replicas: 3
      resources:
        limits:
          cpus: '1'
          memory: 1G
```

### Pattern 2: Kubernetes Deployment

