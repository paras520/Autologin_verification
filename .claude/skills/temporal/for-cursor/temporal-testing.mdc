func TestSendEmail(t *testing.T) {
    mockService := new(MockEmailService)
    emailService = mockService // Inject mock
    
    // Setup expectation
    mockService.On("Send", "user@example.com", "Test").Return(nil)
    
    // Execute
    err := SendEmail(context.Background(), "user@example.com", "Test")
    
    // Assert
    assert.NoError(t, err)
    mockService.AssertExpectations(t)
