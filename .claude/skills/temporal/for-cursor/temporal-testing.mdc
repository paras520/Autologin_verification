func TestSendEmailFailure(t *testing.T) {
    mockService := new(MockEmailService)
    emailService = mockService
    
    mockService.On("Send", "user@example.com", "Test").
        Return(errors.New("SMTP error"))
    
    err := SendEmail(context.Background(), "user@example.com", "Test")
    
    assert.Error(t, err)
    assert.Contains(t, err.Error(), "SMTP error")
