## Testing Patterns

### Test Data Builders

```typescript
// test-helpers.ts
export class OrderBuilder {
  private order = {
    id: 'order-123',
    customerId: 'customer-456',
    items: [],
    total: 0,
  };

  withId(id: string): this {
    this.order.id = id;
    return this;
  }

  withCustomer(customerId: string): this {
    this.order.customerId = customerId;
    return this;
  }

  withItems(items: any[]): this {
    this.order.items = items;
    this.order.total = items.reduce((sum, item) => sum + item.price, 0);
    return this;
  }

  build() {
    return this.order;
  }
}

// Usage in tests
it('processes order with multiple items', async () => {
  const order = new OrderBuilder()
    .withId('order-789')
    .withCustomer('customer-999')
    .withItems([
      { name: 'Item 1', price: 10 },
      { name: 'Item 2', price: 20 },
    ])
    .build();

  const result = await processOrder(order);
  expect(result.total).toBe(30);
});
```

