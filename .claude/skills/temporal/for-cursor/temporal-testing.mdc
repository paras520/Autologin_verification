## Integration Testing Workflows

### TypeScript Workflow Integration Tests

```typescript
// workflows.test.ts
import { TestWorkflowEnvironment } from '@temporalio/testing';
import { Worker } from '@temporalio/worker';
import { orderWorkflow } from './workflows';
import * as activities from './activities';

describe('Order Workflow Integration Tests', () => {
  let testEnv: TestWorkflowEnvironment;

  beforeAll(async () => {
    testEnv = await TestWorkflowEnvironment.createLocal();
  });

  afterAll(async () => {
    await testEnv?.teardown();
  });

  it('completes order successfully', async () => {
    const { client, nativeConnection } = testEnv;
    
    // Create worker
    const worker = await Worker.create({
      connection: nativeConnection,
      taskQueue: 'test',
      workflowsPath: require.resolve('./workflows'),
      activities,
    });

    // Run workflow in test environment
    await worker.runUntil(async () => {
      const result = await client.workflow.execute(orderWorkflow, {
        args: ['order-123'],
        workflowId: 'test-order-123',
        taskQueue: 'test',
      });
      
      expect(result).toBe('Order completed');
    });
  });

  it('handles payment failure', async () => {
    const { client, nativeConnection } = testEnv;
    
    // Mock activity to fail
    const mockActivities = {
      ...activities,
      processPayment: async () => {
        throw new Error('Payment declined');
      },
    };

    const worker = await Worker.create({
      connection: nativeConnection,
      taskQueue: 'test',
      workflowsPath: require.resolve('./workflows'),
      activities: mockActivities,
    });

    await worker.runUntil(async () => {
      await expect(
        client.workflow.execute(orderWorkflow, {
          args: ['order-456'],
          workflowId: 'test-order-456',
          taskQueue: 'test',
        })
      ).rejects.toThrow('Payment declined');
    });
  });

  it('retries failed activities', async () => {
    const { client, nativeConnection } = testEnv;
    
    let attempts = 0;
    const mockActivities = {
      ...activities,
      processPayment: async () => {
        attempts++;
        if (attempts < 3) {
          throw new Error('Temporary failure');
        }
        return { transactionId: 'tx-123', 
      },
    };

    const worker = await Worker.create({
      connection: nativeConnection,
      taskQueue: 'test',
      workflowsPath: require.resolve('./workflows'),
      activities: mockActivities,
    });

    await worker.runUntil(async () => {
      const result = await client.workflow.execute(orderWorkflow, {
        args: ['order-789'],
        workflowId: 'test-order-789',
        taskQueue: 'test',
      });
      
      expect(result).toBe('Order completed');
      expect(attempts).toBe(3); // Verify retries happened
    });
  });
});
```

