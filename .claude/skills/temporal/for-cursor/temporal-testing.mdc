## Performance Testing

### Load Testing Workflows

```typescript
// load-test.ts
import { Connection, WorkflowClient } from '@temporalio/client';

async function loadTest() {
  const connection = await Connection.connect();
  const client = new WorkflowClient({ connection });

  const concurrentWorkflows = 100;
  const iterations = 10;
  
  console.log(`Starting load test: ${concurrentWorkflows * iterations} workflows`);
  
  const startTime = Date.now();

  for (let i = 0; i < iterations; i++) {
    const batch = [];
    
    for (let j = 0; j < concurrentWorkflows; j++) {
      const workflowId = `load-test-${i}-${j}`;
      batch.push(
        client.start(orderWorkflow, {
          args: [workflowId],
          taskQueue: 'load-test',
          workflowId,
        })
      );
    }
    
    await Promise.all(batch);
    console.log(`Started batch ${i + 1}/${iterations}`);
  }

  const duration = Date.now() - startTime;
  const throughput = (concurrentWorkflows * iterations) / (duration / 1000);
  
  console.log(`Load test completed:`);
  console.log(`  Total time: ${duration}ms`);
  console.log(`  Throughput: ${throughput.toFixed(2)} workflows/sec`);
}

loadTest().catch(console.error);
```

### Benchmarking Activities

```typescript
// benchmark-activities.ts
import { performance } from 'perf_hooks';

async function benchmarkActivity(activity: Function, iterations: number) {
  const times: number[] = [];
  
  for (let i = 0; i < iterations; i++) {
    const start = performance.now();
    await activity();
    const end = performance.now();
    times.push(end - start);
  }
  
  const avg = times.reduce((a, b) => a + b, 0) / times.length;
  const min = Math.min(...times);
  const max = Math.max(...times);
  
  console.log(`Benchmark results (${iterations} iterations):`);
  console.log(`  Average: ${avg.toFixed(2)}ms`);
  console.log(`  Min: ${min.toFixed(2)}ms`);
  console.log(`  Max: ${max.toFixed(2)}ms`);
  
  return { avg, min, max };
}
```

## End-to-End Testing

```typescript
// e2e-test.ts
describe('Order Processing E2E', () => {
  let temporalConnection: Connection;
  let client: WorkflowClient;
  let worker: Worker;

  beforeAll(async () => {
    // Connect to real Temporal instance (test environment)
    temporalConnection = await Connection.connect({
      address: process.env.TEMPORAL_ADDRESS || 'localhost:7233',
    });
    
    client = new WorkflowClient({ connection: temporalConnection });
    
    // Start worker
    worker = await Worker.create({
      connection: temporalConnection,
      taskQueue: 'e2e-test',
      workflowsPath: require.resolve('./workflows'),
      activities: realActivities, // Use real implementations
    });
    
    await worker.run();
  });

  afterAll(async () => {
    worker?.shutdown();
    await temporalConnection?.close();
  });

  it('completes full order flow', async () => {
    // Create test order in database
    const orderId = await createTestOrder();
    
    // Start workflow
    const handle = await client.start(orderWorkflow, {
      args: [orderId],
      taskQueue: 'e2e-test',
      workflowId: `e2e-order-${orderId}`,
    });
    
    // Wait for completion
    const result = await handle.result();
    
    // Verify side effects
    const order = await database.orders.findOne({ id: orderId });
    expect(order.status).toBe('completed');
    
    const emails = await emailService.getSent();
    expect(emails).toHaveLength(1);
    expect(emails[0].to).toBe(order.customerEmail);
  }, 30000); // 30 second timeout
});
```

## Best Practices

### ✅ DO

1. **Test at Multiple Levels**
   - Unit tests for activities
   - Integration tests for workflows
   - E2E tests for critical flows

2. **Use Test Helpers**
   - Create reusable mock factories
   - Build test data builders
   - Abstract common setup

3. **Test Error Scenarios**
   - Activity failures
   - Timeouts
   - Non-retryable errors

4. **Time Travel in Tests**
   - Use `testEnv.sleep()` to skip time
   - Test long-running workflows quickly

5. **Verify Side Effects**
   - Check database state
   - Verify external API calls
   - Confirm emails sent

### ❌ DON'T

1. **Don't Test with Production Data**
   - Use test databases
   - Mock external services

2. **Don't Skip Integration Tests**
   - Unit tests alone insufficient
   - Workflow behavior matters

3. **Don't Forget Cleanup**
   - Close connections
   - Clear test data

4. **Don't Ignore Timeouts**
   - Set reasonable test timeouts
   - Long-running tests indicate issues

