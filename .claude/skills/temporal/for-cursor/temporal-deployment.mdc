### 3. Data Encryption

```typescript
// data-codec.ts
import { PayloadCodec } from '@temporalio/client';
import crypto from 'crypto';

export class EncryptionCodec implements PayloadCodec {
  private key: Buffer;
  
  constructor(encryptionKey: string) {
    this.key = Buffer.from(encryptionKey, 'hex');
  }

  async encode(payloads: Payload[]): Promise<Payload[]> {
    return payloads.map((payload) => {
      const iv = crypto.randomBytes(16);
      const cipher = crypto.createCipheriv('aes-256-cbc', this.key, iv);
      
      const encrypted = Buffer.concat([
        cipher.update(payload.data),
        cipher.final(),
      ]);
      
      return {
        metadata: {
          encoding: 'binary/encrypted',
          encryption_iv: iv.toString('base64'),
        },
        data: encrypted,
      };
    });
  }

  async decode(payloads: Payload[]): Promise<Payload[]> {
    return payloads.map((payload) => {
      if (payload.metadata?.encoding !== 'binary/encrypted') {
        return payload;
      }
      
      const iv = Buffer.from(payload.metadata.encryption_iv, 'base64');
      const decipher = crypto.createDecipheriv('aes-256-cbc', this.key, iv);
      
      const decrypted = Buffer.concat([
        decipher.update(payload.data),
        decipher.final(),
      ]);
      
      return {
        ...payload,
        data: decrypted,
        metadata: { encoding: 'binary/plain' },
      };
    });
  }
}
```

## High Availability

### Multi-Region Setup

```yaml
# Architecture for multi-region HA

Primary Region (us-east-1):
- Temporal Cluster (Active)
- PostgreSQL Primary
- Workers (Active)

Secondary Region (us-west-2):
- Temporal Cluster (Standby)
- PostgreSQL Read Replica
- Workers (Active, different task queues)

Failover Strategy:
1. Database replication (streaming)
2. Global load balancer
3. Automatic DNS failover
4. Worker redundancy across regions
```

