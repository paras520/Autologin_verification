### Distributed Tracing

```typescript
// tracing.ts
import { NodeSDK } from '@opentelemetry/sdk-node';
import { getNodeAutoInstrumentations } from '@opentelemetry/auto-instrumentations-node';
import { JaegerExporter } from '@opentelemetry/exporter-jaeger';
import { Resource } from '@opentelemetry/resources';
import { SemanticResourceAttributes } from '@opentelemetry/semantic-conventions';

export function initializeTracing() {
  const sdk = new NodeSDK({
    resource: new Resource({
      [SemanticResourceAttributes.SERVICE_NAME]: 'temporal-worker',
      [SemanticResourceAttributes.SERVICE_VERSION]: process.env.VERSION || '1.0.0',
    }),
    traceExporter: new JaegerExporter({
      endpoint: process.env.JAEGER_ENDPOINT || 'http://localhost:14268/api/traces',
    }),
    instrumentations: [getNodeAutoInstrumentations()],
  });

  sdk.start();

  process.on('SIGTERM', () => {
    sdk.shutdown()
      .then(() => console.log('Tracing terminated'))
      .catch((error) => console.error('Error terminating tracing', error))
      .finally(() => process.exit(0));
  });
}
```

## Security Best Practices

### 1. TLS/mTLS Configuration

```typescript
// secure-connection.ts
import { Connection } from '@temporalio/client';
import fs from 'fs';
import path from 'path';

export async function createSecureConnection() {
  const certPath = process.env.CERT_PATH || '/certs';
  
  return await Connection.connect({
    address: process.env.TEMPORAL_ADDRESS,
    tls: {
      clientCertPair: {
        crt: fs.readFileSync(path.join(certPath, 'client.pem')),
        key: fs.readFileSync(path.join(certPath, 'client-key.pem')),
      },
      serverRootCACertificate: fs.readFileSync(path.join(certPath, 'ca.pem')),
      serverNameOverride: process.env.TEMPORAL_SERVER_NAME,
    },
  });
}
```

