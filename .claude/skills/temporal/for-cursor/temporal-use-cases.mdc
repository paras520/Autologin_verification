## Use Case 1: Background Job Processing

### Detection Patterns
```typescript
// Detect these patterns:
- setTimeout/setInterval
- Job queue libraries (Bull, BullMQ, Celery)
- Async processing needs
- Task queues
```

### Recommended Temporal Approach

**Components**:
- Simple Workflow for job orchestration
- Activities for job execution
- Retry policies for reliability

**Implementation**:

```typescript
// TypeScript Example
// activities.ts
export async function processJob(jobId: string, data: JobData): Promise<JobResult> {
  console.log(`Processing job ${jobId}`);
  
  // Actual job logic
  const result = await performJobWork(data);
  
  // Update job status
  await updateJobStatus(jobId, 'completed', result);
  
  return result;
}

// workflows.ts
import { proxyActivities } from '@temporalio/workflow';
import type * as activities from './activities';

const { processJob } = proxyActivities<typeof activities>({
  startToCloseTimeout: '10 minutes',
  retry: {
    initialInterval: '1s',
    maximumAttempts: 3,
    backoffCoefficient: 2,
  },
});

export async function jobWorkflow(jobId: string, data: JobData): Promise<JobResult> {
  return await processJob(jobId, data);
}

// client.ts - Start job
const client = new WorkflowClient();
await client.start(jobWorkflow, {
  args: ['job-123', jobData],
  taskQueue: 'background-jobs',
  workflowId: `job-${jobId}`,
});
```

```python
# Python Example
from temporalio import workflow, activity
from datetime import timedelta

@activity.defn
async def process_job(job_id: str, data: dict) -> dict:
    # Job processing logic
    result = await perform_job_work(data)
    await update_job_status(job_id, 'completed', result)
    return result

@workflow.defn
class JobWorkflow:
    @workflow.run
    async def run(self, job_id: str, data: dict) -> dict:
        return await workflow.execute_activity(
            process_job,
            job_id,
            data,
            start_to_close_timeout=timedelta(minutes=10),
            retry_policy=RetryPolicy(
                initial_interval=timedelta(seconds=1),
                maximum_attempts=3,
                backoff_coefficient=2.0,
            ),
        )
```

**Benefits**:
- ✅ Automatic retries on failure
- ✅ Job status tracking
- ✅ Visibility into execution
- ✅ No message queue needed

## Use Case 2: Scheduled/Cron Jobs

### Detection Patterns
```typescript
// Detect:
- cron expressions
- setInterval with long intervals
- Scheduled tasks (node-cron, node-schedule)
- AWS EventBridge patterns
```

### Recommended Temporal Approach

**Components**:
- Cron Workflow with schedule
- Activities for task execution

**Implementation**:

```typescript
// TypeScript Example
// workflows.ts
export async function dailyReportWorkflow(): Promise<void> {
  const { generateReport, sendReport, archiveOldReports } = proxyActivities<typeof activities>({
    startToCloseTimeout: '30 minutes',
  });
  
  const reportDate = new Date();
  
  // Generate report
  const report = await generateReport(reportDate);
  
  // Send to stakeholders
  await sendReport(report, ['team@company.com']);
  
  // Cleanup old reports
  await archiveOldReports(30); // Archive reports older than 30 days
}

// client.ts - Schedule workflow
await client.workflow.start(dailyReportWorkflow, {
  taskQueue: 'reports',
  workflowId: 'daily-report',
  cronSchedule: '0 9 * * *', // Every day at 9 AM
});
```

**Alternative: On-demand scheduled workflows**

```typescript
// workflows.ts - With dynamic scheduling
export async function scheduledMaintenanceWorkflow(
  taskType: string,
  scheduleTime: Date
): Promise<void> {
  // Wait until scheduled time
  await sleep(scheduleTime.getTime() - Date.now());
  
  // Execute maintenance
  const { performMaintenance, notifyCompletion } = proxyActivities<typeof activities>({
    startToCloseTimeout: '1 hour',
  });
  
  await performMaintenance(taskType);
  await notifyCompletion(taskType);
}
```

**Benefits**:
- ✅ No cron daemon needed
- ✅ Built-in visibility
- ✅ Failure handling
- ✅ Dynamic scheduling support

## Use Case 3: Distributed Transactions (Saga Pattern)

### Detection Patterns
```typescript
// Detect:
- Multi-service transactions
- Compensation logic
- Rollback requirements
- Two-phase commit patterns
```

### Recommended Temporal Approach

**Components**:
- Workflow for saga coordination
- Activities for each transaction step
- Compensation activities for rollback

**Implementation**:

```typescript
// TypeScript Example - Travel Booking Saga
export async function bookTripWorkflow(tripData: TripBooking): Promise<BookingResult> {
  const activities = proxyActivities<typeof bookingActivities>({
    startToCloseTimeout: '5 minutes',
  });
  
  let flightBooked = false;
  let hotelBooked = false;
  let carBooked = false;
  
  try {
    // Step 1: Book flight
    const flightResult = await activities.bookFlight(tripData.flightDetails);
    flightBooked = true;
    
    // Step 2: Book hotel
    const hotelResult = await activities.bookHotel(tripData.hotelDetails);
    hotelBooked = true;
    
    // Step 3: Book rental car
    const carResult = await activities.bookCar(tripData.carDetails);
    carBooked = true;
    
    // Step 4: Charge customer
    await activities.chargeCustomer(
      tripData.customerId,
      flightResult.price + hotelResult.price + carResult.price
    );
    
    // Step 5: Send confirmation
    await activities.sendConfirmationEmail(tripData.email, {
      flight: flightResult,
      hotel: hotelResult,
      car: carResult,
    });
    
    return {
      
      bookingId: `trip-${Date.now()}`,
      flight: flightResult,
      hotel: hotelResult,
      car: carResult,
    };
    
  } catch (error) {
    // Compensation: Rollback in reverse order
    console.log('Booking failed, rolling back...');
    
    if (carBooked) {
      await activities.cancelCar(tripData.carDetails.reservationId);
    }
    if (hotelBooked) {
      await activities.cancelHotel(tripData.hotelDetails.reservationId);
    }
    if (flightBooked) {
      await activities.cancelFlight(tripData.flightDetails.reservationId);
    }
    
    // Notify customer of failure
    await activities.sendFailureEmail(tripData.email, error.message);
    
    throw error;
  }
}
```

```python
