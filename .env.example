# ── Environment selection ──────────────────────────────────────────────────────
# Selects the block from app.config.json. Options: local | stage1 | stage2 | prod
# Non-secret, environment-specific values (URLs, flags, prompt labels) live there.
APP_ENV=local

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/autologin

# ── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Bifrost LLM Proxy ─────────────────────────────────────────────────────────
# Secret key for Bifrost. The proxy URL and model are set in app.config.json.
BIFROST_API_KEY=

# ── Temporal ──────────────────────────────────────────────────────────────────
# API key for Temporal Cloud (leave empty for local dev server).
TEMPORAL_API_KEY=

# ── Docker ────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
