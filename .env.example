# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/autologin

# ── m103 API (whitelist management service) ───────────────────────────────────
# Verification results are pushed here after each batch so m114 can display them.
M103_BASE_URL=http://127.0.0.1:8001

# ── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=latest
LANGFUSE_EXTRACTOR_PROMPT=autologinQA/identifier_extractor
LANGFUSE_PROVIDER_MATCH_PROMPT=autologinQA/service_matcher
LANGFUSE_CUSTOMER_FACING_PROMPT=autologinQA/customer_facing_classifier

# ── Bifrost LLM Proxy ─────────────────────────────────────────────────────────
# All LLM calls are routed through Bifrost; Langfuse traces are created manually
# by langfuse_helper.py (Bifrost has no native Langfuse integration).
BIFROST_PROXY=https://your-bifrost.run.app
BIFROST_API_KEY=
BIFROST_AUTH_SCHEME=Basic
# Fallback model used ONLY when a Langfuse prompt has no model in its config.
# The model declared in the Langfuse prompt config always takes priority — this
# var is the safety net (and the model used for prompts without configs).
# Use either the bifrost-native form ("vertex/gemini-2.5-flash") or the LiteLLM
# alias ("gemini-2.5-flash"); langfuse_helper translates either way.
BIFROST_MODEL=vertex/gemini-2.5-flash
# Comma-separated default tags appended to every Langfuse trace.
BIFROST_TAGS=autourl_qa, service link verification

# ── Temporal ──────────────────────────────────────────────────────────────────
# For local dev server:  temporal server start-dev
TEMPORAL_URI=localhost:7233
TEMPORAL_NAMESPACE=default

# For Temporal Cloud, set these and leave TEMPORAL_URI pointing to your cloud address:
TEMPORAL_API_KEY=

# Kill switch — set to OFF to bypass Temporal and run inline (no restart needed)
# ON  → all /check/batch calls run as BatchVerificationWorkflow
# OFF → original asyncio.gather inline path (default for safety)
TEMPORAL_STATE=OFF
